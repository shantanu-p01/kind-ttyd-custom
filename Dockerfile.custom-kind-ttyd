# Use the official KinD node image as base
FROM kindest/node:v1.37.0

# Install dependencies, OpenSSH and ttyd
RUN apt-get update && \
    apt-get install -y \
    wget \
    curl \
    vim \
    net-tools \
    netcat-openbsd \
    openssh-server \
    openssh-client \
    openssl \
    bash-completion \
    && rm -rf /var/lib/apt/lists/*

# Download and install ttyd for target architecture
ARG TARGETARCH
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) TTYD_ARCH="x86_64" ;; \
      arm64) TTYD_ARCH="aarch64" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac && \
    wget "https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.${TTYD_ARCH}" -O /usr/local/bin/ttyd && \
    chmod +x /usr/local/bin/ttyd

# Default credentials (can be overridden via build args if building from source)
ARG DEFAULT_USER=kind
ARG DEFAULT_PASSWORD=kind123

# Create credentials file and configure root password
RUN mkdir -p /etc/default && \
    echo "TTYD_USER=${DEFAULT_USER}" > /etc/default/ttyd && \
    echo "TTYD_PASSWORD=${DEFAULT_PASSWORD}" >> /etc/default/ttyd && \
    chmod 600 /etc/default/ttyd && \
    mkdir -p /var/run/sshd && \
    echo "root:${DEFAULT_PASSWORD}" | chpasswd && \
    sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config || true && \
    sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config || true && \
    grep -q "PermitRootLogin yes" /etc/ssh/sshd_config || echo "PermitRootLogin yes" >> /etc/ssh/sshd_config && \
    grep -q "PasswordAuthentication yes" /etc/ssh/sshd_config || echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config && \
    if [ -f /lib/systemd/system/ssh.service ]; then ln -s /lib/systemd/system/ssh.service /etc/systemd/system/multi-user.target.wants/ssh.service || true; fi

# Create startup script for ttyd (reads dynamically from /etc/default/ttyd)
RUN cat > /usr/local/bin/start-ttyd.sh <<'START_TTYD_EOF'
#!/bin/bash
[ -f /etc/default/ttyd ] && . /etc/default/ttyd
TTYD_USER="${TTYD_USER:-kind}"
TTYD_PASSWORD="${TTYD_PASSWORD:-kind123}"
exec /usr/local/bin/ttyd -p 55555 -c "${TTYD_USER}:${TTYD_PASSWORD}" -t fontSize=16 -t theme='{"background":"#1e1e1e"}' -W bash
START_TTYD_EOF
RUN chmod +x /usr/local/bin/start-ttyd.sh

# Create password utility to update ttyd & root passwords anytime
RUN cat > /usr/local/bin/change-password <<'CHANGE_PASS_EOF'
#!/bin/bash
set -e

CONFIG_FILE="/etc/default/ttyd"
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
CURRENT_USER="${TTYD_USER:-kind}"
NEW_PASS=""
NEW_USER="$CURRENT_USER"

while getopts "p:u:h" opt; do
  case "$opt" in
    p) NEW_PASS="$OPTARG" ;;
    u) NEW_USER="$OPTARG" ;;
    h)
      echo "Usage: change-password [-p <password>] [-u <username>]"
      exit 0
      ;;
    *)
      echo "Usage: change-password [-p <password>] [-u <username>]"
      exit 1
      ;;
  esac
done

if [ -z "$NEW_PASS" ]; then
  echo ""
  echo -e "\033[1;36m🔑 Update Password (ttyd web terminal & root)\033[0m"
  echo "Username: $NEW_USER"
  echo ""
  while true; do
    read -r -s -p "Enter new password: " p1
    echo ""
    if [ -z "$p1" ]; then
      echo "Password cannot be empty. Please try again."
      continue
    fi
    read -r -s -p "Confirm new password: " p2
    echo ""
    if [ "$p1" != "$p2" ]; then
      echo "Passwords do not match. Please try again."
    else
      NEW_PASS="$p1"
      break
    fi
  done
fi

cat > "$CONFIG_FILE" <<EOF
TTYD_USER=$NEW_USER
TTYD_PASSWORD=$NEW_PASS
EOF
chmod 600 "$CONFIG_FILE"

echo "root:$NEW_PASS" | chpasswd
touch /root/.password_changed

echo ""
echo -e "\033[1;32m✅ Password successfully updated for user '$NEW_USER' and system 'root'!\033[0m"

if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ttyd 2>/dev/null; then
  echo "🔄 Restarting ttyd web service..."
  echo "⚠️  If connected via web terminal, please refresh your browser to re-login."
  sleep 1
  systemctl restart ttyd 2>/dev/null || true
fi
CHANGE_PASS_EOF
RUN chmod +x /usr/local/bin/change-password

# Create systemd service to start ttyd after system boots
RUN mkdir -p /etc/systemd/system/ && \
    cat > /etc/systemd/system/ttyd.service <<'TTYD_SVC_EOF'
[Unit]
Description=ttyd - web terminal
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/start-ttyd.sh
Restart=always

[Install]
WantedBy=multi-user.target
TTYD_SVC_EOF
RUN ln -s /etc/systemd/system/ttyd.service /etc/systemd/system/multi-user.target.wants/ttyd.service

# Set KUBECONFIG environment variable for kubectl access in ttyd terminal
RUN echo 'export KUBECONFIG=/etc/kubernetes/admin.conf' >> /root/.bashrc

# Generate SSH keypair for passwordless inter-node SSH and enable authorized_keys
RUN mkdir -p /root/.ssh && \
    ssh-keygen -t rsa -b 2048 -f /root/.ssh/id_rsa -N '' -q && \
    cat /root/.ssh/id_rsa.pub >> /root/.ssh/authorized_keys && \
    chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys && chmod 600 /root/.ssh/id_rsa && chmod 644 /root/.ssh/id_rsa.pub

# Set HOME environment variable properly
ENV HOME=/root

# Create node discovery script that finds other kind nodes and updates /etc/hosts
RUN cat > /usr/local/bin/kind-node-discovery.sh <<'DISCOVERY_EOF'
#!/bin/bash
set -e

# Start sshd if not running
mkdir -p /var/run/sshd
pgrep -x sshd >/dev/null 2>&1 || /usr/sbin/sshd

# Extract cluster name from hostname
CLUSTER_PREFIX=$(hostname | sed 's/-control-plane$//;s/-worker[0-9]*$//')

# Discover and map nodes
TEMP_HOSTS=/tmp/kind-hosts-$$
> "$TEMP_HOSTS"

# Try control-plane
if IP=$(getent hosts ${CLUSTER_PREFIX}-control-plane 2>/dev/null | awk '{print $1}' | head -n1); then
  [ -n "$IP" ] && echo "$IP control-plane" >> "$TEMP_HOSTS"
fi

# Try workers
for i in "" 2 3 4 5; do
  NODE_NAME="${CLUSTER_PREFIX}-worker${i}"
  if [[ -z "$i" ]]; then
    SHORT_NAME="worker01"
  else
    SHORT_NAME=$(printf "worker%02d" $i)
  fi
  if IP=$(getent hosts $NODE_NAME 2>/dev/null | awk '{print $1}' | head -n1); then
    [ -n "$IP" ] && echo "$IP $SHORT_NAME" >> "$TEMP_HOSTS"
  fi
done

# Update /etc/hosts if we found nodes
if [ -s "$TEMP_HOSTS" ]; then
  sed -i "/# kind-ssh-shortcuts/d" /etc/hosts 2>/dev/null || true
  while IFS= read -r line; do
    echo "$line # kind-ssh-shortcuts" >> /etc/hosts
  done < "$TEMP_HOSTS"
fi

rm -f "$TEMP_HOSTS"
DISCOVERY_EOF

RUN chmod +x /usr/local/bin/kind-node-discovery.sh

# Create systemd service for node discovery (runs every 500ms)
RUN echo '[Unit]' > /etc/systemd/system/kind-node-discovery.service && \
    echo 'Description=Kind Node Discovery Service' >> /etc/systemd/system/kind-node-discovery.service && \
    echo 'After=network.target' >> /etc/systemd/system/kind-node-discovery.service && \
    echo '' >> /etc/systemd/system/kind-node-discovery.service && \
    echo '[Service]' >> /etc/systemd/system/kind-node-discovery.service && \
    echo 'Type=simple' >> /etc/systemd/system/kind-node-discovery.service && \
    echo 'ExecStart=/bin/bash -c "while true; do /usr/local/bin/kind-node-discovery.sh; sleep 0.5; done"' >> /etc/systemd/system/kind-node-discovery.service && \
    echo 'Restart=always' >> /etc/systemd/system/kind-node-discovery.service && \
    echo 'RestartSec=5' >> /etc/systemd/system/kind-node-discovery.service && \
    echo '' >> /etc/systemd/system/kind-node-discovery.service && \
    echo '[Install]' >> /etc/systemd/system/kind-node-discovery.service && \
    echo 'WantedBy=multi-user.target' >> /etc/systemd/system/kind-node-discovery.service && \
    ln -s /etc/systemd/system/kind-node-discovery.service /etc/systemd/system/multi-user.target.wants/kind-node-discovery.service

# Improve interactive shell: show colored short hostname prompt (no username)
RUN echo '' >> /root/.bashrc && \
    echo '# -- kind customizations: colored prompt with short hostname' >> /root/.bashrc && \
    echo 'export HOME=/root' >> /root/.bashrc && \
    echo 'cd ~' >> /root/.bashrc && \
    echo '# Load bash-completion' >> /root/.bashrc && \
    echo '[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion' >> /root/.bashrc && \
    echo 'if [ -n "$PS1" ]; then' >> /root/.bashrc && \
    echo '  if [[ "$HOSTNAME" == *"control-plane"* ]]; then' >> /root/.bashrc && \
    echo '    HOST_SHORT="control-plane"' >> /root/.bashrc && \
    echo '    alias k=kubectl' >> /root/.bashrc && \
    echo '    source <(kubectl completion bash)' >> /root/.bashrc && \
    echo '    complete -o default -F __start_kubectl k' >> /root/.bashrc && \
    echo '  elif [[ "$HOSTNAME" == *"worker"* ]]; then' >> /root/.bashrc && \
    echo '    WORKER_NUM=$(echo "$HOSTNAME" | grep -oP "worker\\K[0-9]*" || echo "")' >> /root/.bashrc && \
    echo '    if [[ -z "$WORKER_NUM" ]]; then' >> /root/.bashrc && \
    echo '      HOST_SHORT="worker01"' >> /root/.bashrc && \
    echo '    else' >> /root/.bashrc && \
    echo '      HOST_SHORT=$(printf "worker%02d" $WORKER_NUM)' >> /root/.bashrc && \
    echo '    fi' >> /root/.bashrc && \
    echo '  else' >> /root/.bashrc && \
    echo '    HOST_SHORT="${HOSTNAME%%.*}"' >> /root/.bashrc && \
    echo '  fi' >> /root/.bashrc && \
    echo '  export PS1="\\[\\033[01;32m\\]${HOST_SHORT}\\[\\033[00m\\]:\\[\\033[01;34m\\]\\w\\[\\033[00m\\]\\$ "' >> /root/.bashrc && \
    echo 'fi' >> /root/.bashrc

# Prompt user to change password on first interactive login
RUN cat >> /root/.bashrc <<'BASHRC_EOF'

# First login password prompt
if [[ $- == *i* ]]; then
  if [ -f /etc/default/ttyd ]; then
    _curr_pw=$(grep '^TTYD_PASSWORD=' /etc/default/ttyd 2>/dev/null | cut -d'=' -f2-)
    if [ -n "$_curr_pw" ] && [ "$_curr_pw" != "kind123" ]; then
      touch /root/.password_changed 2>/dev/null || true
    fi
  fi
  if [ ! -f /root/.password_prompt_shown ] && [ ! -f /root/.password_changed ]; then
    touch /root/.password_prompt_shown
    echo ""
    echo -e "\033[1;33m┌─────────────────────────────────────────────────────────────────┐\033[0m"
    echo -e "\033[1;33m│\033[0m \033[1;31m⚠️  SECURITY ALERT: Default Password Active                     \033[1;33m│\033[0m"
    echo -e "\033[1;33m│\033[0m Current credentials: username '\033[1;37mkind\033[0m' | password '\033[1;37mkind123\033[0m'        \033[1;33m│\033[0m"
    echo -e "\033[1;33m│\033[0m It is strongly recommended to change your password now.         \033[1;33m│\033[0m"
    echo -e "\033[1;33m└─────────────────────────────────────────────────────────────────┘\033[0m"
    echo ""
    read -r -p "Would you like to change your password now? [y/N]: " _change_choice
    case "$_change_choice" in
      [yY]|[yY][eE][sS])
        /usr/local/bin/change-password
        ;;
      *)
        echo ""
        echo -e "\033[0;36mDefault password kept. You can change it anytime with: \033[1mchange-password\033[0m"
        echo ""
        ;;
    esac
  fi
fi
BASHRC_EOF

WORKDIR /root